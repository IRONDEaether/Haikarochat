# Copie ce fichier en .env et remplis tes valeurs
SECRET_KEY=change-moi-vraiment
OWNER_CODE=ton-code-proprio-secret
ADMIN_CODE=ton-code-admin

# ===================================================================
# BASE MYSQL (RECOMMANDE en production - Render a un disque ephemere)
# >>> C'EST ICI QUE TU COLLES L'URL DE TA BASE MYSQL <<<
# Format : mysql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE
# Exemple : mysql://hikaro:MonPass123@mysql-xxxx.render.com:3306/hikarochat
# Sur Render : service -> Environment -> Add Variable -> Key=DATABASE_URL
# Laisse vide pour rester en JSON local (dev uniquement, NON persistant).
DATABASE_URL=

# Supabase (alternative optionnelle a MySQL)
SUPABASE_URL=
SUPABASE_KEY=

# Email support / notifications (optionnel)
SUPPORT_EMAIL=raphaelod760@protonmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Serveur
HOST=0.0.0.0
PORT=5000

# Multi-serveurs (2+ instances) : identifiant + file Redis partagee.
# Laisse MESSAGE_QUEUE vide pour un seul serveur.
INSTANCE_ID=hikaro-1
MESSAGE_QUEUE=
# ex 2 serveurs : MESSAGE_QUEUE=redis://localhost:6379/0
